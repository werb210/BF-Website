{
  "routes": [
    {
      "route": "/refer",
      "redirect": "https://staff.boreal.financial/referrer/signup",
      "statusCode": 302
    },
    {
      "route": "/refer/",
      "redirect": "https://staff.boreal.financial/referrer/signup",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/icons/*",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.svg",
      "/*.ico",
      "/*.json",
      "/*.txt",
      "/*.xml"
    ]
  }
}
