{
  "routes": [
    {
      "route": "/refer",
      "redirect": "https://staff.boreal.financial/referrer/signup",
      "statusCode": 302
    },
    {
      "route": "/referrer",
      "redirect": "https://staff.boreal.financial/referrer/signup",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/icons/*",
      "/*.{css,js,json,txt,xml,png,jpg,jpeg,svg,ico,webmanifest}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
